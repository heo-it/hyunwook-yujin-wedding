---
import "@/styles/global.css";
import { LINK } from "@/constants/constants";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, minimum-scale=1.0, maximum-scale=1.0, user-scalable=no"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <meta property="og:title" content="최현욱 ♥︎ 허유진 결혼합니다." />
    <meta
      property="og:description"
      content="2025년 11월 1일 토요일 오전 11시"
    />
    <meta property="og:image" content="/assets/middle_cover.jpg" />
    <title>최현욱 ♥︎ 허유진 결혼합니다.</title>
    <meta name="description" content="2025년 11월 1일 토요일 오전 11시" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Crimson+Pro:ital,wght@0,200..900;1,200..900&family=Italiana&family=Playfair+Display:ital,wght@0,400..900;1,400..900&display=swap"
      rel="stylesheet"
    />
    <link
      rel="preload"
      as="font"
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap"
    />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Alex+Brush&display=swap"
    />
    <script
      type="text/javascript"
      src={`//dapi.kakao.com/v2/maps/sdk.js?appkey=${import.meta.env.PUBLIC_KAKAO_MAP_APP_KEY}`}
    ></script>
  </head>
  <body>
    <slot />
    <script type="text/javascript" src=`${LINK.NAVER_MAP}`></script>
  </body>
</html>

<style>
  html,
  body {
    margin: auto;
    width: 100%;
    max-width: 430px;
    box-shadow: 0 0 18px rgba(0, 0, 0, 0.1);
    font-family: "SUIT Variable -apple-system, sans-serif";
  }
</style>
