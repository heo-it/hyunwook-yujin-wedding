---
import dayjs from "dayjs";
import { getDatesGroupedByWeek } from "@/lib/calendar";
import CalendarHeader from "./CalendarHeader.astro";
import CalendarTable from "./CalendarTable.astro";

const { dueDate } = Astro.props;

const weeklyDateGroups = getDatesGroupedByWeek(dueDate);
const month = dayjs(dueDate).month() + 1;
---

<div
  class="flex flex-col py-12 my-16 text-[color:--color-gray-900] bg-neutral-50"
>
  <CalendarHeader month={month} />
  <CalendarTable weeklyDateGroups={weeklyDateGroups} dueDate={dueDate} />
  <section
    class="fade-in flex flex-col items-center justify-center gap-1 text-[color:--color-gray-300]/20 font-Pretendard"
  >
    <p>2025년 11월 1일 토요일 오전 11시</p>
    <p>평택 SG웨딩 라베아툼홀</p>
  </section>
</div>
