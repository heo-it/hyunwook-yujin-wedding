---
import AccountItem from "./AccountItem.astro";
---

<div
  class="flex flex-col items-center gap-4 my-20 font-Pretendard text-[#444447]"
>
  <h2 class="font-Italiana text-xl">CONGRATS!</h2>
  <div class="flex flex-col w-full min-w-[100px] mb-4">
    <p
      class="relative flex w-full h-12 px-4 justify-center items-center gap-1 self-stretch"
    >
      🤵🏻‍♂️ 신랑측&nbsp;&nbsp;
    </p>
    <div class="w-full bg-white border-t border-[rgba(0,0,0,0.10)]">
      <AccountItem
        bank="신한은행"
        accountNumber="123-456-7890"
        owner="최현욱"
        successMessage="계좌번호가 복사되었습니다!"
      />
      <AccountItem
        bank="카카오뱅크"
        accountNumber="987-654-3210"
        owner="최민식"
        successMessage="계좌번호가 복사되었습니다!"
