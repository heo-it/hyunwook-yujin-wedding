---
import NaverMap from "@/assets/navermap_Icon.png";
import KakaoMap from "@/assets/kakaomap_Icon.png";
import TMap from "@/assets/tmap_Icon.svg";
import { LINK, LOCATION } from "@/constants/constants";
import { Map } from "./Map";
import NavigationButton from "./NavigationButton.astro";
---

<div class="flex flex-col py-10">
  <p class="text-lg text-center text-[color:--color-gray-900] mb-8">
    오시는 길
  </p>
  <Map
    client:only="react"
    latitude={LOCATION.LATITUDE}
    longitude={LOCATION.LONGITUDE}
  />
  <div class="px-8 text-sm">
    <div class="flex flex-col gap-4 border-b pb-9">
      <div class="flex flex-col gap-2">
        <p class="text-[color:--color-gray-900] text-[17px]">네비게이션</p>
        <p class="text-[color:--color-gray-700] text-base font-light">
          원하시는 앱을 선택하시면 길안내가 시작됩니다.
        </p>
      </div>
      <div class="flex gap-2">
        <NavigationButton
          title="네이버 지도"
          src={NaverMap.src}
          alt="Naver Map"
          link={LINK.NAVER_MAP_APP}
        />
        <NavigationButton
          title="카카오맵"
          src={KakaoMap.src}
          alt="Kakao Map"
          link={LINK.KAKAO_MAP_APP}
        />
        <NavigationButton
          title="티맵"
          src={TMap.src}
          alt="T Map"
          link={LINK.T_MAP_APP}
        />
      </div>
    </div>
    <div class="flex flex-col gap-2 border-b py-9">
      <p class="text-[color:--color-gray-900] text-[17px]">지하철</p>
      <p class="text-[color:--color-gray-700] text-base font-light text-base">
        <span class="text-[#0d347f]">●</span> 1호선 지젤역 1번 출구
      </p>
    </div>
    <div class="flex flex-col gap-2 border-b py-9">
      <p class="text-[color:--color-gray-900] text-[17px]">버스</p>
      <p class="text-[color:--color-gray-700] text-base font-light text-base">
        하차 - 지젤역 2번 출구,
        <br />
        더샵지제역센트럴파크3BL 아파트
      </p>
    </div>
    <div class="flex flex-col gap-2 py-9">
      <p class="text-[color:--color-gray-900] text-[17px]">자가용</p>
      <p class="text-[color:--color-gray-700] text-base font-light text-base">
        2시간 무료 주차
        <br />
        본관 주차장에서 직원의 안내를 받으시길 바랍니다.
        <br />
        출차시 별도 등록이 필요하지 않습니다.
      </p>
    </div>
  </div>
</div>
