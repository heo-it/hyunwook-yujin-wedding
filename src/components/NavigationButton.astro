---
const { src, alt, link, title } = Astro.props;
---

<astro-greet data-link={link} class="grow shrink basis-0">
  <button
    class="flex items-center justify-center gap-2 w-full h-[40px] border border-gray-100 rounded-lg"
    data-link={link}
  >
    <img src={src} alt={alt} width={16} height={16} />
    <span>{title}</span>
  </button>
</astro-greet>

<script>
  class AstroGreet extends HTMLElement {
    connectedCallback() {
      const buttons = this.querySelectorAll("button");
      buttons.forEach((button) => {
        button.addEventListener("click", () => {
          window.open(this.dataset.link, "_blank");
        });
      });
    }
  }

  customElements.define("astro-greet", AstroGreet);
</script>
