---
import Calendar from "@/components/Calendar.astro";
import Gallery from "@/components/Gallery.astro";
import Location from "@/components/Location.astro";
import Layout from "@/layouts/Layout.astro";
import CoverImage from "@/components/CoverImage.astro";
import Introduction from "@/components/Introduction.astro";
import Footer from "@/components/Footer.astro";
import AccountInfo from "@/components/AccountInfo.astro";
import Contact from "@/components/Contact.astro";
import Modal from "@/components/Modal.astro";
---

<Layout>
  <CoverImage />
  <hr class="my-12 mx-auto w-10 border-[color:--color-gray-500]" />
  <Introduction />
  <Calendar dueDate="2025-11-01 11:00" />
  <Gallery />
  <Location />
  <AccountInfo />
  <Contact />
  <Footer />
</Layout>

<!-- 환영 모달 -->
<div id="welcomeModal">
  <Modal 
    isOpen={true}
    title="환영합니다"
    message="예식이 원활히 진행될 수 있도록\n<span class='font-semibold'>예정 시간보다 10분 앞선 오전 10시 50분에 식이 시작</span>될 예정입니다.\n방문하시는 하객 여러분의 참고 부탁드립니다."
    onClose={() => {
      document.getElementById('welcomeModal')?.classList.add('hidden');
    }}
  />
</div>

<script>
  // 페이지 로드 시 모달이 이미 열려있도록 설정
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('welcomeModal');
    if (modal) {
      modal.classList.remove('hidden');
    }
  });
</script>
